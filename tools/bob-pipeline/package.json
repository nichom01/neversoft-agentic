{
  "name": "bob-pipeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @bob-pipeline/server\" \"npm run dev -w @bob-pipeline/web\"",
    "build": "npm run build -w @bob-pipeline/web",
    "start": "npm run build && npm run start -w @bob-pipeline/server",
    "validate": "npm run validate -w @bob-pipeline/server",
    "setup-labels": "npm run setup-labels -w @bob-pipeline/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
